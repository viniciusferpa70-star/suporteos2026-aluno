{
  "info": {
    "name": "Suporte OS - Loja de Informatica - Apresentacao",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute 01 a 12 na ordem. IDs sao capturados automaticamente. Rodar novamente cria outro conjunto ficticio. Nenhuma credencial incluida."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 - Servidor responde",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Corpo OK\", () => pm.expect(pm.response.text()).to.eql(\"OK\"));",
              "pm.collectionVariables.set(\"runId\", Date.now().toString());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Cadastrar grupo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/grupos-produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Perifericos {{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"grupoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Cadastrar fornecedor ficticio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/fornecedores",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razaoSocial\": \"Distribuidora demonstracao {{runId}}\",\n  \"cnpj\": \"0{{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"fornecedorId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Cadastrar mouse com garantia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoBarras\": \"INF-{{runId}}\",\n  \"descricao\": \"Mouse USB - demonstracao\",\n  \"saldoEstoque\": 10,\n  \"valorUnitario\": 59.90,\n  \"estoqueMinimo\": 2,\n  \"grupoId\": {{grupoId}},\n  \"fornecedorId\": {{fornecedorId}},\n  \"garantiaMeses\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"produtoId\", pm.response.json().id);",
              "pm.test(\"Garantia e valor do estoque\", () => { pm.expect(pm.response.json().garantiaMeses).to.eql(12); pm.expect(pm.response.json().valorEstoque).to.eql(599); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Consultar produto salvo",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/{{produtoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"ID persistido\",()=>pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"produtoId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Listar produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Listar grupos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/grupos-produtos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Listar fornecedores",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/fornecedores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Erro 400 saldo negativo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoBarras\": \"INF-{{runId}}\",\n  \"descricao\": \"Mouse USB - demonstracao\",\n  \"saldoEstoque\": -1,\n  \"valorUnitario\": 59.90,\n  \"estoqueMinimo\": 2,\n  \"grupoId\": {{grupoId}},\n  \"fornecedorId\": {{fornecedorId}},\n  \"garantiaMeses\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Campo saldo\",()=>pm.expect(pm.response.json().fields).to.have.property(\"saldoEstoque\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Erro 404 produto inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/9223372036854775807"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Erro 409 codigo repetido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoBarras\": \"INF-{{runId}}\",\n  \"descricao\": \"Mouse USB - demonstracao\",\n  \"saldoEstoque\": 10,\n  \"valorUnitario\": 59.90,\n  \"estoqueMinimo\": 2,\n  \"grupoId\": {{grupoId}},\n  \"fornecedorId\": {{fornecedorId}},\n  \"garantiaMeses\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Erro 400 garantia invalida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoBarras\": \"INF-{{runId}}\",\n  \"descricao\": \"Mouse USB - demonstracao\",\n  \"saldoEstoque\": 10,\n  \"valorUnitario\": 59.90,\n  \"estoqueMinimo\": 2,\n  \"grupoId\": {{grupoId}},\n  \"fornecedorId\": {{fornecedorId}},\n  \"garantiaMeses\": 61\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
